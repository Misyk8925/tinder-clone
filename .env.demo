# Local demo only. Never use this file on a public host.
# Loaded by scripts/demo-up.sh. Docker Compose interpolates `$` in this file,
# so BCrypt hashes belong in docker-compose.demo.yml ($$-escaped), not here.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=demo-postgres

PROFILES_DB_USER=profiles_app
PROFILES_DB_PASSWORD=demo-profiles-db
MATCH_DB_USER=match_app
MATCH_DB_PASSWORD=demo-match-db
CONSUMER_DB_USER=consumer_app
CONSUMER_DB_PASSWORD=demo-consumer-db
SUBSCRIPTIONS_DB_USER=subscriptions_app
SUBSCRIPTIONS_DB_PASSWORD=demo-subscriptions-db
SWIPES_DB_USER=swipes_app
SWIPES_DB_PASSWORD=demo-swipes-db
LOCATION_DB_USER=location_app
LOCATION_DB_PASSWORD=demo-location-db
MODERATION_DB_USER=moderation_app
MODERATION_DB_PASSWORD=demo-moderation-db

MODERATION_ADMIN_USERNAME=policy-admin
MODERATION_ADMIN_PASSWORD_HASH=replaced-by-docker-compose.demo.yml
MODERATION_CLIENT_USERNAME=moderation-client
MODERATION_CLIENT_PASSWORD=demo-moderation-client
MODERATION_CLIENT_PASSWORD_HASH=replaced-by-docker-compose.demo.yml

MATCH_DB_URL=jdbc:postgresql://postgres:5432/match_db

MTLS_KEYSTORE_PASSWORD=changeit
MTLS_TRUSTSTORE_PASSWORD=changeit

# Subscriptions starts, billing endpoints stay off (StripeConfig treats "placeholder" as unset).
STRIPE_SECRET_KEY=placeholder
STRIPE_WEBHOOK_SECRET=placeholder
STRIPE_PRICE_ID=placeholder
PUBLIC_APP_PROFILE_URL=http://localhost:4200/profile

# Compose requires these keys; the demo overlay empties the photos bucket so MemoryStorage is used.
AWS_ACCESS_KEY_ID=lunari-demo-not-aws
AWS_SECRET_ACCESS_KEY=lunari-demo-not-aws
CLOUDFRONT_DOMAIN=http://photos:8070
AWS_S3_BUCKET=unused-local-demo
AWS_REGION=eu-north-1
CDN_ENABLED=false

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=demo-keycloak-admin
KEYCLOAK_POSTGRES_PASSWORD=demo-keycloak-db
KEYCLOAK_URL=http://localhost:9080
KEYCLOAK_REALM=spring
KEYCLOAK_CLIENT_ID=spring-app
KEYCLOAK_CLIENT_SECRET=demo-local-client-secret

DECK_READ_CURSOR_SECRET=demo-deck-read-cursor-hmac-secret
PHOTOS_INTERNAL_AUTH_SECRET=demo-photos-internal-secret

MATCH_WS_ALLOWED_ORIGINS=http://localhost:4200
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:4200
