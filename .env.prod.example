# Copy this file to .env.local and set real values before production deployment.
# Never commit .env.local.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

# Per-service DB users (recommended for least privilege)
PROFILES_DB_USER=profiles_app
PROFILES_DB_PASSWORD=replace-with-strong-password
MATCH_DB_USER=match_app
MATCH_DB_PASSWORD=replace-with-strong-password
CONSUMER_DB_USER=consumer_app
CONSUMER_DB_PASSWORD=replace-with-strong-password
SUBSCRIPTIONS_DB_USER=subscriptions_app
SUBSCRIPTIONS_DB_PASSWORD=replace-with-strong-password
SWIPES_DB_USER=swipes_app
SWIPES_DB_PASSWORD=replace-with-strong-password
LOCATION_DB_USER=location_app
LOCATION_DB_PASSWORD=replace-with-strong-password
MODERATION_DB_USER=moderation_app
MODERATION_DB_PASSWORD=replace-with-strong-password

# Internal HTTP Basic users for the moderation service.
# Password hashes must be BCrypt ($2a/$2b). The plaintext password is only
# used by profiles/match when they call POST /internal/v1/moderations.
MODERATION_ADMIN_USERNAME=policy-admin
MODERATION_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
MODERATION_CLIENT_USERNAME=moderation-client
MODERATION_CLIENT_PASSWORD=replace-with-strong-password
MODERATION_CLIENT_PASSWORD_HASH=replace-with-bcrypt-hash

# Optional live providers. When empty, moderation uses a local fallback classifier.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# JDBC URL used by match inside the Compose network
MATCH_DB_URL=jdbc:postgresql://postgres:5432/match_db

# mTLS certificates passwords
MTLS_KEYSTORE_PASSWORD=replace-with-keystore-password
MTLS_TRUSTSTORE_PASSWORD=replace-with-truststore-password

# Stripe settings
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
PROFILES_BASE_URL=https://profiles.your-domain.example/api/profiles
PUBLIC_APP_PROFILE_URL=https://your-domain.example/profile
STRIPE_PRICE_ID=replace-with-stripe-price-id

# AWS/S3 settings used by profiles/match services
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
CLOUDFRONT_DOMAIN=https://cdn.your-domain.example
AWS_S3_BUCKET=replace-with-s3-bucket-name
AWS_REGION=replace-with-aws-region
CDN_ENABLED=true

# Keycloak settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-password
KEYCLOAK_POSTGRES_PASSWORD=replace-with-strong-password
KEYCLOAK_URL=https://keycloak.your-domain.example
KEYCLOAK_REALM=spring
KEYCLOAK_CLIENT_ID=spring-app
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret

# HMAC secret for deck-read opaque cursors (must be set; Compose will not start without it)
DECK_READ_CURSOR_SECRET=replace-with-cursor-hmac-secret

# Shared secret the profiles and match services present to the photos service.
# The photos service serves no media request without it, so all three must agree.
PHOTOS_INTERNAL_AUTH_SECRET=replace-with-photos-internal-secret

# Browser origins allowed to open the chat WebSocket and to call the gateway with
# credentials. Comma-separated; never set either to "*".
MATCH_WS_ALLOWED_ORIGINS=https://your-frontend.example
GATEWAY_CORS_ALLOWED_ORIGINS=https://your-frontend.example

# Optional external Keycloak fields for no-keycloak profile
# KEYCLOAK_AUTH_SERVER_URL=https://keycloak.your-domain.example
# KEYCLOAK_JWK_SET_URI=https://keycloak.your-domain.example/realms/spring/protocol/openid-connect/certs
